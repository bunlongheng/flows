# ── Artifact API (mirrors the diagrams app) ───────────────────────────────────

# Secret token for the public render-only API (POST /api/ai/flows).
# Server-only. NEVER a NEXT_PUBLIC_*/VITE_* var, never referenced client-side.
# Generate with: openssl rand -hex 24
FLOWS_API_SECRET="your-secret-token-here"

# Postgres connection string, e.g. postgresql://localhost:5432/flows
# (add user:password@ and ?sslmode=require for a remote DB).
DATABASE_URL="postgresql://localhost:5432/flows"
DATABASE_SSL="true" # "true" for remote Postgres (rejectUnauthorized:false)

# Owner UUID used as flows.user_id for API-created artifacts.
OWNER_USER_ID="00000000-0000-0000-0000-000000000000"

# Public base URL used to build the returned artifact URL.
FLOWS_APP_URL="https://flows-bheng.vercel.app"

# Anthropic key - ONLY for the admin-only POST /api/ai/generate (local/owner).
# Get one at https://console.anthropic.com/ and paste it here.
ANTHROPIC_API_KEY=""

# ── Owner Google sign-in (gates AI generation in prod) ─────────────────────────
# Google OAuth 2.0 Web client (console.cloud.google.com -> Credentials).
# Authorized redirect URI: <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Session-cookie signing secret. Generate with: openssl rand -hex 32
AUTH_SECRET=""
# Only this Google account may sign in and use AI generation.
OWNER_EMAIL="you@example.com"

# DEV-ONLY auth bypass (treats localhost/LAN as the owner). NEVER set in prod.
# LOCAL_DEV="true"

# ── AirClips (optional, MCP-only picture nodes) ─────────────────────────────
# Lets a node's image: "airclips:<id>" / "airclips:latest" pull from the
# AirClips board. Both optional - only needed to use that image source.
# AIRCLIPS_URL="http://M4.local:7474"
# AIRCLIPS_TOKEN=""

